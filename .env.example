# Copie este archivo a .env y cambie los valores (nunca suba .env al repositorio).
# En Render estas variables se configuran en el panel o en render.yaml (RNF-4.3, RNF-11.2).
DATABASE_USERNAME=cupo
DATABASE_PASSWORD=cambie-esta-clave
# Mínimo 32 caracteres aleatorios
JWT_SECRET=cambie-este-secreto-de-al-menos-32-caracteres
CORS_ALLOWED_ORIGIN=http://localhost:5173
BOOTSTRAP_ADMIN_USERNAME=admin
# Mínimo 12 caracteres
BOOTSTRAP_ADMIN_PASSWORD=cambie-esta-clave
# Opcional: secreto TOTP (Base32) del administrador inicial para la demostración
BOOTSTRAP_ADMIN_TOTP_SECRET=
# Token del Edge de la maqueta: debe empezar por pwd_ (genere uno aleatorio)
DEVICE_TOKEN=pwd_cambie-este-token-del-edge
